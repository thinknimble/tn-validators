  },
  "keywords": [
    "javascript"
  ],
  "homepage": "https://bitbucket.org/thinknimble/tn-validators#readme",
  "dependencies": {
    "email-validator": "^2.0.4",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/register": "^7.29.7",
    "mocha": "^12.0.0"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "useBuiltIns": false
        }
      ]
    ]
  },
  "overrides": {
    "brace-expansion@1": ">=1.1.18 <2.0.0",
    "picomatch@2": ">=2.3.2 <3.0.0",
    "semver@5": ">=5.7.2 <6.0.0",
    "debug@4": ">=4.3.1"
  }
